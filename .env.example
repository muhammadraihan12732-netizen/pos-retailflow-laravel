APP_NAME="RetailFlow POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (MySQL / MariaDB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=retailflow_pos
DB_USERNAME=root
DB_PASSWORD=

# --- Alternatif SQLite (tanpa install MySQL) ---
# DB_CONNECTION=sqlite
# (lalu buat file kosong: database/database.sqlite)

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Info toko (tampil di struk) ---
STORE_NAME="RetailFlow Store"
STORE_ADDRESS="Jl. Contoh No. 123, Surabaya"
STORE_PHONE="031-1234567"
STORE_RECEIPT_FOOTER="Terima kasih sudah berbelanja!"
